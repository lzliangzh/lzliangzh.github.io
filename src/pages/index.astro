---
import { getCollection, getEntry } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE, EMAIL } from "../consts";
import Layout from "../layouts/Layout.astro";

// 获取首页 Markdown
const entry = await getEntry("posts", "whoami");
const { Content } = entry ? await entry.render() : { Content: null };

// 获取最近的 6 篇文章
const allPosts = await getCollection("posts", ({ id }) => id !== "index.md");
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const currentYear = new Date().getFullYear();

// 简单的季度判断函数，用于保持你参考样式中的间距逻辑
const getQuarter = (date: Date) => Math.floor(date.getMonth() / 3);

// 获取最新的一篇文章（用于 Latest 部分）
const latestPost = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  className="flex min-h-svh max-w-2xl flex-col justify-left"
>
  <main class="py-16 px-6 mx-auto w-full space-y-16">
    
    <section class="flex flex-col space-y-6 lg:flex-row lg:space-y-0 justify-between">
    <div class="aspect-square w-20">
    <img 
      src="/author.png" 
      class="rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-800 group-hover:ring-zinc-900 dark:group-hover:ring-zinc-100 transition-all"
    />
    </div>
    <header>
    <div class="text-4xl font-bold sans">Zhong <span class="font-normal text-3xl">“Leo”</span> <span style="font-variant: small-caps">Liang</span></div>
    <div class="space-x-6 text-xl font-medium sans"><span>梁 钟</span><span>[lɪɑŋ˧˥.tʂʊŋ˥]</span></div>
    <div class="pt-6 prose prose-zinc dark:prose-invert italic">3rd Year Student @ Peking University</div>
    </header>

    </section>
    {Content && (
      <section class="prose prose-zinc dark:prose-invert max-w-none 
        prose-p:text-[15px] prose-p:leading-relaxed 
        prose-a:text-zinc-900 dark:prose-a:text-zinc-100 prose-a:underline-offset-4
        hyphens-auto" lang="en">
        <Content />
      </section>
    )}


       
  </main>
</Layout>